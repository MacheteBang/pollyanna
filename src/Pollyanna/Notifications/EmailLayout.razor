@*
    The HTML part of every email (spec §12, §15): "the panel on the band". From the top: the
    wordmark on white (the bow, then "pollyanna" in bold lowercase text); a pale-blue band, the
    email's stand-in for the cloth, holding one white panel with the event's name, the kind's text,
    a full-width ink button to its link and the link as small soft text; the footer on white. No
    text sits on the band, and there is no status stamp.

    Before it all comes hidden preview text for inbox lists: the kind's text, then a run of
    invisible spacers so the snippet stops there. Both are aria-hidden, so screen readers read
    the kind's text once, in the panel.

    Styles are inline, and every surface sets its own background, so a client that darkens the
    email swaps whole surfaces. The one image is the bow, carried inside the message as a CID part
    (EmailBow); nothing is loaded from anywhere. Every value is HTML-encoded by the renderer, so
    names can't inject markup. Rendered by MailHtml.

    Contrast (WCAG AA, spec §15): ink #1E1A16 on white 17.3 (wordmark, heading, text, footer
    link) and white on the ink button the same; soft ink #5B5650 on white 7.3 (the small URL and
    the footer). The pale-blue band holds no text.
*@
<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light only">
<meta name="supported-color-schemes" content="light only">
<title>@Content.Subject</title>
</head>
<body style="margin:0; padding:0; background-color:@White;">
<div lang="en" dir="ltr" style="margin:0; padding:0; background-color:@White; color:@Ink; color-scheme:light only; font-family:@Font; font-size:16px; line-height:1.5;">
<div aria-hidden="true" style="@HiddenStyle">@string.Join(' ', Lines(Content.Body))</div>
<div aria-hidden="true" style="@HiddenStyle">@Spacer</div>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse; background-color:@White;">
<tr>
<td align="center" style="background-color:@White; padding:16px;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse; max-width:560px;">
<tr>
<td style="background-color:@White;">
<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse;">
<tr>
<td width="26" valign="middle" style="padding:0 8px 0 0; line-height:0; font-size:0;"><img src="cid:@EmailBow.ContentId" width="26" height="26" alt="" style="display:block; border:0; width:26px; height:26px;"></td>
<td valign="middle" style="font-family:@Font; color:@Ink; font-size:22px; line-height:26px; font-weight:800; letter-spacing:-0.44px;">pollyanna</td>
</tr>
</table>
</td>
</tr>
</table>
</td>
</tr>
<tr>
<td align="center" style="background-color:@PaleBlue; padding:24px 16px 56px 16px;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-collapse:separate; max-width:560px;">
<tr>
<td style="background-color:@White; border-radius:10px; padding:24px;">
<h1 style="margin:0 0 12px 0; font-family:@Font; color:@Ink; font-size:23px; line-height:1.15; font-weight:800; letter-spacing:-0.46px;">@Event.Name</h1>
@foreach (var line in Lines(Content.Body))
{
<p style="margin:0 0 12px 0; font-family:@Font; color:@Ink; font-size:16px; line-height:1.5;">@line</p>
}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-collapse:separate; margin-top:12px;">
<tr>
<td align="center" style="background-color:@Ink; border-radius:10px;"><a href="@Content.Link" style="display:block; padding:13px 16px; font-family:@Font; font-size:18px; line-height:1.3; font-weight:800; color:@White; background-color:@Ink; text-decoration:none; border-radius:10px;">@ButtonLabel(Content.Link)</a></td>
</tr>
</table>
<p style="margin:12px 0 0 0; font-family:@Font; color:@SoftInk; font-size:14px; line-height:1.5; word-break:break-all;">@Content.Link</p>
</td>
</tr>
</table>
</td>
</tr>
<tr>
<td align="center" style="background-color:@White; padding:24px 16px 32px 16px;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse; max-width:560px;">
<tr>
<td style="background-color:@White;">
@foreach (var line in Audience.FooterLines(Event, PublicUrl))
{
@if (line.Link is { } link)
{
<p style="margin:0 0 4px 0; font-family:@Font; color:@SoftInk; font-size:14px; line-height:1.5; word-break:break-word;">@line.Text <a href="@link" style="color:@Ink; font-weight:600; text-decoration:underline;">@link</a></p>
}
else
{
<p style="margin:0 0 4px 0; font-family:@Font; color:@SoftInk; font-size:14px; line-height:1.5;">@line.Text</p>
}
}
</td>
</tr>
</table>
</td>
</tr>
</table>
</div>
</body>
</html>

@code {
    // The "Tablecloth" colors the email uses (spec §12), all solid.
    const string White = "#FFFFFF", Ink = "#1E1A16", SoftInk = "#5B5650", PaleBlue = "#DCE7EE";

    /// <summary>Figtree can't be loaded (nothing remote), so the email uses the system font stack (spec §15).</summary>
    const string Font = "-apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif";

    /// <summary>
    /// Hides the preview text and its spacer run from view in every client: Outlook keeps it out with
    /// mso-hide, the rest with display:none and, where that is stripped, no height and no ink.
    /// </summary>
    const string HiddenStyle = "display:none; font-size:1px; line-height:1px; max-height:0; max-width:0; opacity:0; overflow:hidden; mso-hide:all;";

    /// <summary>
    /// Invisible characters after the preview text, so inbox lists don't carry on into the wordmark
    /// and heading (spec §15). A fixed string, so written as markup rather than encoded.
    /// </summary>
    static readonly MarkupString Spacer = new(string.Concat(Enumerable.Repeat("&#847;&zwnj;&nbsp;", 100)));

    /// <summary>What the kind says: the subject (the title), its text and its link.</summary>
    [Parameter, EditorRequired] public NotificationContent Content { get; set; } = null!;

    /// <summary>Who it is for, which decides the footer.</summary>
    [Parameter, EditorRequired] public Audience Audience { get; set; }

    /// <summary>The event as it is when the email is sent: its name heads the panel.</summary>
    [Parameter, EditorRequired] public Pollyanna.Data.Event Event { get; set; } = null!;

    /// <summary>The public URL, without a trailing slash.</summary>
    [Parameter, EditorRequired] public string PublicUrl { get; set; } = null!;

    /// <summary>One paragraph per line of the plain text.</summary>
    static IEnumerable<string> Lines(string text) => text.Split('\n').Where(l => l.Length > 0);

    /// <summary>The button's label, by where the link goes rather than by kind (spec §15).</summary>
    static string ButtonLabel(string link) =>
        link.EndsWith("/manage", StringComparison.Ordinal) ? "Open the manage page"
        : link.EndsWith("/questions", StringComparison.Ordinal) ? "Read the question"
        : "Open the event";
}

@page "/auth/failed"
@{
    ViewData["Title"] = "Sign-in didn't work";
    var providerProblem = Request.Query["reason"] == "provider";
    // PROTOTYPE (wayfinder #13): an open provider's refusal, Development only.
    var protoVariant = Request.Query["variant"].ToString().ToUpperInvariant();
    var proto = Request.Query["reason"] == "refused" && protoVariant is "A" or "B"
        && HttpContext.RequestServices.GetRequiredService<IWebHostEnvironment>().IsDevelopment();
}
@if (proto)
{
    ViewData["ProtoView"] = "refused";
    ViewData["ProtoVariant"] = protoVariant;
    ViewData["ProtoCase"] = Request.Query["case"].ToString() is "unverified" or "ambiguous" ? Request.Query["case"].ToString() : "unknown";
    <partial name="_SignInPrototype" />
    return;
}

<div class="empty">
    <h1>Sign-in didn't work</h1>
    <p>Your sign-in provider didn't let you in, or the sign-in took too long. Nothing was changed.</p>
    @if (providerProblem)
    {
        <p>The sign-in service turned Pollyanna away. Whoever runs this site needs to check its settings.</p>
    }
</div>
<div class="actions">
    <a class="button" href="/auth/login">Try again</a>
</div>

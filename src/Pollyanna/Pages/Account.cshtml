@page "/account/{handler?}"
@model AccountModel
@{
    ViewData["Title"] = "Your account";
}

<a class="back" href="/">← Your exchanges</a>
<h1>Your account</h1>

<section class="slip slip-plain stack" id="logins" aria-labelledby="logins-heading">
    <h2 id="logins-heading">Ways to sign in</h2>
    <ul class="people" role="list">
        @foreach (var login in Model.Logins)
        {
            <li class="person">
                <div class="person-body">
                    <span class="person-name">@login.Label@if (login.NoLongerSetUp)
                        {<span class="red-text"> (no longer set up)</span>}</span>
                    <span class="small break">@(login.LastEmail ?? "No email sent")</span>
                </div>
                <form method="post" action="/account/removelogin" asp-antiforgery="true">
                    <input type="hidden" name="loginId" value="@login.Id">
                    <button type="submit" class="link-button red-text tap" aria-label="Remove @login.Label@(login.LastEmail is null ? "" : $" ({login.LastEmail})")">Remove</button>
                </form>
            </li>
        }
    </ul>
    @if (Model.AddChoices.Count > 0)
    {
        <div class="actions">
            @foreach (var provider in Model.AddChoices)
            {
                <form method="post" action="/account/addlogin" asp-antiforgery="true">
                    <input type="hidden" name="key" value="@provider.Key">
                    <partial name="_ProviderButton" model='new Pollyanna.Pages.Shared.ProviderButtonView(provider, "Add " + provider.Label, null, Outline: true)' />
                </form>
            }
        </div>
    }
    <p class="small">Your name, email and picture come from your latest sign-in. A removed way to sign in whose verified email matches yours is added back the next time you use it. Your only way to sign in can't be removed: to leave Pollyanna, <a href="/account/delete">delete your account</a> instead.</p>
</section>

@if (Model.EmailsAvailable)
{
    <section class="slip slip-plain" id="emails" aria-labelledby="emails-heading">
        <h2 id="emails-heading">Emails</h2>
        <form method="post" action="/account/emails" asp-antiforgery="true" class="stack">
            <label class="choice">
                <input type="checkbox" id="emails-on" name="on" value="true" checked="@Model.EmailsOn">
                <span>Email me about Pollyanna events</span>
            </label>
            <p class="small">Pollyanna emails you when something in an event needs you, such as an event opening or names being drawn. Turning this off stops all of them, including any not sent yet.</p>
            <button type="submit" class="button button-outline">Save</button>
        </form>
    </section>
}

<section class="slip slip-plain" aria-labelledby="signout-heading">
    <h2 id="signout-heading">Sign out</h2>
    <p class="small">This signs you out of Pollyanna on this device. It doesn't sign you out of your sign-in provider.</p>
    <form method="post" action="/auth/signout" asp-antiforgery="true">
        <button type="submit" class="button">Sign out</button>
    </form>
</section>

<section class="slip slip-plain" aria-labelledby="delete-heading">
    <h2 id="delete-heading">Delete your account</h2>
    <p class="small">Deletes your name, email, picture and notes from Pollyanna, and takes you out of events that aren't over yet.</p>
    <a class="button button-outline" href="/account/delete">Delete my account…</a>
</section>

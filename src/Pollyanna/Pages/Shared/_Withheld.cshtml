@model string
@* A part between a giver and a recipient, left out of a live refetch a hint set off (spec §16;
   Pollyanna.Live.LiveRefetch.CarriesPairParts): only its place, by id, so the script keeps the
   one it already shows. *@
<div class="live-slot" id="@Model" data-live data-live-pair data-live-withheld></div>

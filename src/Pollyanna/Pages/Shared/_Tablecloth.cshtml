@* The "Tablecloth" layout shell (spec §7, §12), every page's layout (_ViewStart). The masthead
   runs the full width; the page's body follows it directly, so the page decides where the cloth
   goes. See notes on the pieces (.column, _PageHead, .cloth > .panel, .below, .button-fill) in
   tablecloth.css. A page adds a font to preload with a "Preload" section. *@
@inject Pollyanna.WhatsNew.WhatsNewList WhatsNew
@inject TimeProvider Clock
@{
    var signedIn = User.Identity?.IsAuthenticated == true;
    var name = User.Identity?.Name?.Trim();
    var firstName = string.IsNullOrEmpty(name) ? "Your account" : name.Split(' ', 2)[0];
    var live = Pollyanna.Live.LiveShape.Of(ViewData);
    // A live refetch a hint set off leaves out the rows tied to an assignment (spec §16).
    var pairParts = Pollyanna.Live.LiveRefetch.CarriesPairParts(Context.Request);
    var news = signedIn
        ? new Pollyanna.Pages.Shared.WhatsNewPanelView(await WhatsNew.RowsAsync(User.PersonId(), workedOut: pairParts), Clock.GetUtcNow().UtcDateTime, Withheld: !pairParts)
        : null;
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light">
    <title>@(ViewData["Title"] is string title ? $"{title} · Pollyanna" : "Pollyanna")</title>
    <link rel="preload" href="~/fonts/figtree-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="~/fonts/figtree-latin-800-normal.woff2" as="font" type="font/woff2" crossorigin>
    @await RenderSectionAsync("Preload", required: false)
    <link rel="stylesheet" href="~/css/tablecloth.css" asp-append-version="true">
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="~/apple-touch-icon.png">
    <script src="~/js/site.js" asp-append-version="true" defer></script>
</head>
<body>
    <header class="masthead">
        <a class="brand" href="/"><partial name="_TableclothGirl" model="40" /><span>pollyanna</span></a>
        @if (news is not null)
        {
            <nav class="masthead-end" aria-label="Account">
                <partial name="_WhatsNewPanel" model="news" />
                <a class="masthead-account" href="/account">@firstName</a>
            </nav>
        }
    </header>
    @* A page that updates live names its shape and the quiet line for arriving at it (spec §16;
       Pollyanna.Live.LiveShape): a live refetch with another shape is a state change. It names
       its own path (as content frames file it), where a refetch sent on goes, and the words the
       script shows for what a refetch can't show. The empty live line is where the script puts
       that line ("Names have been drawn." Show) and says it. *@
    <main data-live-shape="@live?.Shape" data-live-line="@live?.Line" data-live-path="@live?.Path" data-live-moved="@live?.Moved"
          data-live-words="@(live is null ? null : Pollyanna.Live.LiveShape.Words)">
        <div class="column"><partial name="_Notice" /></div>
        @if (live is not null)
        {
            <div class="column" data-live-say aria-live="polite"></div>
        }
        @RenderBody()
    </main>
</body>
</html>

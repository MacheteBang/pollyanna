@model Pollyanna.Pages.Shared.WhatsNewPanelView
@using Pollyanna.Infrastructure
@* The bell and its "What's new" panel (spec §7, §12, §16; the #89 mockup, variant A). The bell is
   filled with something new and outlined without, never a number. Without the script it is the
   link to /whats-new and the panel stays hidden; site.js (whatsNewPanel) hides the link, shows
   the button, opens and closes the panel, and dismisses in place by posting each row's own form,
   the same post as the page. The panel comes right after the button so Tab goes into it. *@
@{
    var bell = "M12 3a6 6 0 0 0-6 6v3.6L4 16.5h16l-2-3.9V9a6 6 0 0 0-6-6z";
    var clapper = "M9.8 18.5a2.2 2.2 0 0 0 4.4 0z";
}
<a class="@Model.BellClass" href="/whats-new" aria-label="@Model.BellLabel" data-bell-link>
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path class="bell-body" d="@bell"/><path class="bell-clapper" d="@clapper"/></svg>
</a>
<button type="button" class="@Model.BellClass" aria-label="@Model.BellLabel" aria-expanded="false"
        aria-controls="whats-new-panel" data-bell hidden>
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path class="bell-body" d="@bell"/><path class="bell-clapper" d="@clapper"/></svg>
</button>
<div class="bell-panel" id="whats-new-panel" role="region" aria-labelledby="whats-new-panel-heading" hidden>
    <h2 class="bell-panel-heading" id="whats-new-panel-heading">What's new</h2>
    <ul class="rows bell-rows" role="list">
        @foreach (var row in Model.Rows)
        {
            <li class="row bell-row">
                <span class="row-stack">
                    <a class="bell-line" href="@row.Href">@row.Line</a>
                    <span class="small soft bell-meta">@row.EventName@if (row.At is { } at)
                    {<text> · </text><time datetime="@Format.IsoMinute(at)" data-when>@Format.When(at, Model.Now)</time>}</span>
                </span>
                <form method="post" action="/whats-new/dismiss" asp-antiforgery="true" data-bell-dismiss>
                    <input type="hidden" name="event" value="@row.EventId">
                    <input type="hidden" name="kind" value="@row.Kind">
                    <button type="submit" class="bell-x" aria-label="Dismiss: @row.Line">
                        <svg viewBox="0 0 14 14" aria-hidden="true" focusable="false"><path d="M2 2l10 10M12 2L2 12"/></svg>
                    </button>
                </form>
            </li>
        }
    </ul>
    <div class="bell-empty" hidden="@(Model.Rows.Count > 0)">
        <p class="bell-empty-title">Nothing new right now.</p>
        <p class="small soft">When something happens in one of your events, it shows up here.</p>
    </div>
</div>

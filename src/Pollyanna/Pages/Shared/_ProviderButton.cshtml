@model Pollyanna.Pages.Shared.ProviderButtonView
@* One provider's button, with its icon when the operator supplied one (ProviderButtonView). Its
   classes work under both stylesheets: in site.css ("Paper slips") .button is filled and
   .button-outline outlined; in tablecloth.css .button is outlined and .button-fill filled. *@
@{
    var css = Model.Outline ? "button button-outline provider-button" : "button button-fill provider-button";
    var icon = Model.Provider.IconPath;
}
@if (Model.Href is not null)
{
    <a class="@css" href="@Model.Href">@if (icon is not null) {<img class="provider-icon" src="@icon" alt="">}@Model.Text</a>
}
else
{
    <button class="@css" type="submit">@if (icon is not null) {<img class="provider-icon" src="@icon" alt="">}@Model.Text</button>
}

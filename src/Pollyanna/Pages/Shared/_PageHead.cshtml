@model Pollyanna.Pages.Shared.PageHeadView
@* The page head (PageHeadView, spec §7): back link, title (the page's h1), one small soft line.
   Sits in the column, straight under the masthead and above the cloth. *@
<div class="column page-head">
    @if (Model.Back is { } back)
    {
        <a class="page-head-back" href="@back.Href">@back.Text</a>
    }
    <h1 class="page-title">@Model.Title</h1>
    @if (Model.Line is not null)
    {
        <p class="page-head-line">@Model.Line</p>
    }
</div>

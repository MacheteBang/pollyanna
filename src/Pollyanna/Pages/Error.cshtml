@page "/error/{code:int?}"
@model ErrorModel
@{
    Layout = "_Tablecloth";
    ViewData["Title"] = Model.Heading;
}

@* An error page (spec §7, §12): the girl large, a heading, one or two sentences, one way out. No cloth. *@
<div class="column lone">
    <partial name="_TableclothGirl" model="130" />
    <h1 class="page-title">@Model.Heading</h1>
    <p>@Model.Message</p>
    <a class="lone-way-out" href="/">Back to your events</a>
</div>

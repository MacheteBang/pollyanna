@page
@model IndexModel
@using Pollyanna.Infrastructure
@using Pollyanna.Pages.Shared
@{
    ViewData["Title"] = Model.Events.Count > 0 ? "Your events" : "No events yet";
    // Live (spec §16): each panel patches in place, comes and goes; empty home and home with
    // events are two shapes, and moving between them swaps the page.
    Pollyanna.Live.LiveShape.MarkHome(ViewData, empty: Model.Events.Count == 0);
}

@if (Model.Events.Count > 0)
{
    @* Home with events (spec §7): one panel per event on the one cloth, each with its name and
       the one thing waiting on the viewer. No about text. *@
    <h1 class="visually-hidden">Your events</h1>
    <div class="cloth home-cloth" id="home-events" data-live-list>
        @foreach (var e in Model.Events)
        {
            var line = IndexModel.Line(e);
            <section class="panel" id="event-@e.Id" data-live aria-label="@e.Name">
                <h2 class="panel-title"><a class="home-event" href="@e.Href">@e.Name</a></h2>
                <p class="home-when"><partial name="_When" model="e.ExchangeDate" /></p>
                <p class="small soft">@Format.StatusLine(e.Status)@(string.IsNullOrWhiteSpace(e.BudgetText) ? "" : " · " + e.BudgetText)</p>
                @if (e.IsOrganizer)
                {
                    <p class="small soft">You organize · @Format.People(e.ParticipantCount)@(e.InvitationCount > 0 ? " · " + Format.Invites(e.InvitationCount) : "")</p>
                }
                @* The waiting line patches on its own; in a drawn event it can be about the viewer's
                   recipient or giver, so a refetch a hint set off leaves it out (spec §16). *@
                @if (e.Withheld)
                {
                    <partial name="_Withheld" model="@($"waiting-{e.Id}")" />
                }
                else
                {
                    <div class="live-slot" id="waiting-@e.Id" data-live data-live-pair>
                        @if (line is { } l)
                        {
                            <a class="button button-fill waiting" href="@l.Href">@l.Text</a>
                        }
                    </div>
                }
            </section>
        }
    </div>
    <div class="column below home-more">
        <a class="button button-start" href="/events/new">New event</a>
        <a href="/past">Past events</a>
    </div>
}
else
{
    @* Empty home (spec §7): one panel in two equal halves, both buttons outlined; the long
       about text below, then "Past events". *@
    <partial name="_PageHead" model="@(new PageHeadView("No events yet"))" />
    <div class="cloth">
        <div class="panel">
            <h2 class="panel-title">I was invited</h2>
            @if (Model.Email is null)
            {
                <p>Your sign-in account has no email address, so an invitation by email can't reach you. Ask the organizer to add you by name instead. You can be picked now that you've signed in.</p>
            }
            else
            {
                @if (Model.EmailVerified == false)
                {
                    <p>Your sign-in account says this email isn't verified, so invitations to it can't reach you. Verify it with your sign-in provider, or ask the organizer to add you by name.</p>
                }
                else
                {
                    <p>Give the organizer this address so they can add you. The event shows up here once they do.</p>
                }
                <div class="copy-line">
                    <strong class="break email-address">@Model.Email</strong>
                    <button type="button" class="button" data-copy="@Model.Email" hidden>Copy</button>
                </div>
            }
            <div class="panel-split">
                <h2 class="panel-title">I'm organizing one</h2>
                <p>Set a date and a budget, add your people, then draw names.</p>
                <a class="button button-start" href="/events/new">New event</a>
            </div>
        </div>
    </div>
    <div class="column below">
        <partial name="_About" />
        <a href="/past">Past events</a>
    </div>
}

@page "/past"
@model PastModel
@using Pollyanna.Infrastructure
@using Pollyanna.Pages.Shared
@{
    ViewData["Title"] = "Past events";
}

@* Past events (spec §7): a plain list with no cloth. Each row is one link: the name; date and
   budget; the viewer's part in it. No status word: everything here is over. *@
<partial name="_PageHead" model="@(new PageHeadView("Past events", Back: new("Home", "/")))" />
<div class="column">
    @if (Model.Events.Count == 0)
    {
        <p>No past events yet. Events move here once an organizer archives them.</p>
    }
    else
    {
        <ul class="past-list" role="list">
            @foreach (var e in Model.Events)
            {
                <li>
                    <a class="past-row" href="/events/@e.Id">
                        <span class="past-name">@e.Name</span>
                        <span class="small soft"><time datetime="@Format.IsoDate(e.ExchangeDate)">@Format.Date(e.ExchangeDate)</time>@(string.IsNullOrWhiteSpace(e.BudgetText) ? "" : " · " + e.BudgetText)</span>
                        <span class="small soft">@(e.IsParticipant ? "You took part" : "You organized") · @Format.People(e.ParticipantCount)@(e.Revealed ? " · pairings revealed" : "")</span>
                    </a>
                </li>
            }
        </ul>
    }
</div>

@page "/events/{id:guid}/{handler?}"
@model Pollyanna.Pages.Events.EventModel
@{
    ViewData["Title"] = Model.Event.Name;
    // Before the draw the page is in "Tablecloth": _EventHead, then the state's own partial. The
    // states after it (#76 the reveal, #77 the event once it's over) are still "Paper slips" and
    // move the same way: switch the layout for them and render _EventHead above their partial.
    var beforeDraw = !Model.Membership.NamesDrawn;
    Layout = beforeDraw ? "_Tablecloth" : "_Layout";
}
@if (beforeDraw)
{
    <partial name="_EventHead" model="Model" />
    <partial name="_EventBeforeDraw" model="Model" />
}
else
{
    <partial name="_EventPaperSlips" model="Model" />
}

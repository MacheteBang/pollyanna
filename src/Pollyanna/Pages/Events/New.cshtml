@page "/events/new"
@model Pollyanna.Pages.Events.NewModel
@using Pollyanna.Events
@using Pollyanna.Infrastructure
@using Pollyanna.Pages.Shared
@{
    ViewData["Title"] = "New event";
    var head = new PageHeadView("New event", BackText: "Home", BackHref: "/");
}

<partial name="_PageHead" model="head" />

@* The whole form is the one panel on the cloth (spec §7, §12). It adds nobody but the linked
   event's people; the rest are added on the organizing page. *@
<div class="cloth">
    <form method="post" action="/events/new" asp-antiforgery="true" class="panel">
        @if (Model.Error is not null)
        {
            <p class="notice notice-error" role="alert">@Model.Error</p>
        }
        <div class="field">
            <label for="name">Name</label>
            <input id="name" name="Name" value="@Model.Name" required maxlength="@EventManager.NameMax" autocomplete="off">
        </div>
        <div class="field">
            <label for="date">Exchange date</label>
            <input id="date" name="ExchangeDate" type="date" value="@(Model.ExchangeDate is { } d ? Format.IsoDate(d) : "")" required min="2000-01-01" max="2100-12-31">
        </div>
        <div class="field">
            <label for="budget">Budget</label>
            <input id="budget" name="BudgetText" value="@Model.BudgetText" maxlength="@EventManager.BudgetMax" autocomplete="off" aria-describedby="budget-hint">
            <p class="small soft" id="budget-hint">Optional. Shown to everyone taking part.</p>
        </div>
        <label class="check" for="take-part">
            <input id="take-part" type="checkbox" name="TakePart" value="true" checked="@Model.TakePart">
            Yes, I'm taking part too
        </label>
        @* An unticked box sends nothing, so this "false" is what arrives then. *@
        <input type="hidden" name="TakePart" value="false">
        @if (Model.Candidates.Count > 0)
        {
            <div class="field">
                <label for="previous">Same group as an earlier event</label>
                <select id="previous" name="PreviousEventId" data-previous-select aria-describedby="previous-hint">
                    <option value="" selected="@(Model.PreviousEventId is null)">No, start with nobody</option>
                    @foreach (var c in Model.Candidates)
                    {
                        <option value="@c.Id" selected="@(c.Id == Model.PreviousEventId)">@c.Name, @Format.MonthYear(c.ExchangeDate)</option>
                    }
                </select>
                <p class="small soft" id="previous-hint">Optional. Brings the same people and households along.</p>
            </div>
            <div class="field" data-needs-previous>
                <label for="depth">Don't repeat who gave to whom</label>
                <select id="depth" name="NoRepeatDepth">
                    @for (var n = 1; n <= EventManager.MaxNoRepeatDepth; n++)
                    {
                        <option value="@n" selected="@(n == Model.NoRepeatDepth)">@(n == 1 ? "From the last event" : $"From the last {n} events")</option>
                    }
                </select>
            </div>
        }
        <button type="submit" class="button button-fill">Create event</button>
        <p class="small soft">It starts as a draft only organizers can see. You add people next.</p>
    </form>
</div>

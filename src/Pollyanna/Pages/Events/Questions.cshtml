@page "/events/{id:guid}/questions/{handler?}"
@model Pollyanna.Pages.Events.QuestionsModel
@using Pollyanna.Data
@using Pollyanna.Events
@using Pollyanna.Infrastructure
@using Pollyanna.Live
@using Pollyanna.Pages.Shared
@*
    "Questions for you" (spec §7, §12), as a conversation: the giver's messages on the left, the
    viewer's on the right, oldest at the top, a day line between days. The page is always the
    cloth, running to the bottom of the page: the conversation in its own scrolling box and the
    reply box (one line, "Send" filled beside it) are the panel on it, and "Close this
    conversation" sits under the panel, still on the cloth. Replying doesn't change the page's
    shape. Day lines and times are in UTC on the page ("about 4 PM UTC"); site.js redoes them in
    the viewer's own time zone (conversations()).

    Live (spec §16): everything under the page head is one region, and the conversation another
    inside it, so with a reply being written (which keeps the outer one as it is) a new question
    still arrives. The page's shape is the event's status.
*@
@{
    ViewData["Title"] = "Questions for you";
    Pollyanna.Live.LiveShape.Mark(ViewData, "questions", Model.Event);
    var thread = Model.Thread;
}

<partial name="_PageHead" model="@(new PageHeadView("Questions for you", "Your giver asks, you answer. Their name stays a secret.", new Pollyanna.Pages.Shared.BackLink(Model.Event.Name, $"/events/{Model.Event.Id}")))" />

@{
    void Conversation(QuestionThread t)
    {
        <div class="live-slot" id="thread" data-live data-thread>
        <div class="thread-scroll">
        <ol class="conversation" data-conversation>
            @{ DateOnly? day = null; }
            @foreach (var note in t.Notes)
            {
                var mine = note.Sender == MessageSender.Recipient;
                var on = DateOnly.FromDateTime(note.CreatedAt);
                if (on != day)
                {
                    day = on;
                    <li class="day-line" data-day><time datetime="@Format.IsoDate(on)">@QuestionsModel.DayLine(on, Model.Today)</time></li>
                }
                <li class="message @(mine ? "message-mine" : "message-theirs")">
                    <p class="bubble"><span class="visually-hidden">@(mine ? "You:" : "Your giver:")</span> <span class="bubble-body">@note.Body</span></p>
                    <p class="message-meta"><time datetime="@Format.IsoMinute(note.CreatedAt)" data-said="@(note.OnTheHour ? "hour" : "")">@Format.Said(note)</time>@if (Model.IsNew(note))
                        {
                            <text> · </text><strong class="message-new">new</strong>
                        }</p>
                </li>
            }
        </ol>
        </div>
        </div>
    }

    async Task Reply()
    {
        <partial name="_Notice" view-data="@(new ViewDataDictionary(ViewData) { ["NoticeAt"] = "reply" })" />
        <form method="post" asp-page-handler="reply" id="reply" class="composer" data-composer>
            <textarea id="reply-body" name="body" rows="1" maxlength="@EventManager.MessageMax" required
                      placeholder="Reply to your giver" aria-label="Reply to your giver"></textarea>
            <button type="submit" class="button button-fill">Send</button>
        </form>
    }

    async Task Close()
    {
        <div class="conversation-foot">
            <form method="post" asp-page-handler="close">
                <button type="submit" class="link-button small">Close this conversation</button>
            </form>
        </div>
    }
}

@if (!Request.CarriesPairParts())
{
    @* A refetch a hint set off leaves the viewer's own thread out (spec §16): it's between them and their giver. *@
    <partial name="_Withheld" model="@("questions")" />
}
else
{
<div class="live-slot" id="questions" data-live data-live-pair>
<div class="cloth questions-cloth">
    <div class="panel conversation-panel">
        @if (thread is not { Notes.Count: > 0 })
        {
            <p>No questions yet. When your giver asks you something, it shows up here and you can reply.</p>
        }
        else
        {
            Conversation(thread);
            if (thread.Closed)
            {
                <partial name="_Notice" view-data="@(new ViewDataDictionary(ViewData) { ["NoticeAt"] = "reply" })" />
                <section id="reply" class="conversation-closed" aria-labelledby="closed-heading">
                    <h2 id="closed-heading">You closed this conversation</h2>
                    <p class="small soft">Your giver can't send more questions, and you can't reply, until you reopen it.</p>
                    <form method="post" asp-page-handler="reopen">
                        <button type="submit" class="button">Reopen it</button>
                    </form>
                </section>
            }
            else
            {
                await Reply();
            }
        }
    </div>
    @if (thread is { Notes.Count: > 0, Closed: false })
    {
        await Close();
    }
</div>
</div>
}

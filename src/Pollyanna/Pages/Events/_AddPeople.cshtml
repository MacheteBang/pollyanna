@model Pollyanna.Pages.Events.AddPeopleControl
@using Pollyanna.Events
@* The add-people control's fields (spec §7). Its container carries data-add-people. Without the
   script it is a plain ticklist and an email field; the script adds the filter box, which turns a
   full address into a ticked "Add or invite" row and hides the email field. *@
<div class="field" data-add-people-filter hidden>
    <label for="add-people-filter">Filter, or type an email</label>
    <input id="add-people-filter" type="text" autocomplete="off" maxlength="@EventManager.EmailMax">
</div>
<fieldset class="choices">
    <legend>From your exchanges</legend>
    @if (Model.Known.Count == 0)
    {
        <p class="small">Nobody to list yet. Type their email instead.</p>
    }
    <ul class="people" role="list">
        @foreach (var p in Model.Known)
        {
            @* Someone prefilled from the linked earlier event is already ticked there (spec §4). The
               script shows them again if another earlier event, or none, is picked. *@
            var groups = Model.GroupsOf(p.Id);
            var prefilled = Model.Prefilled(p.Id);
            <li class="person" data-search="@p.Name.ToLowerInvariant()" data-previous-groups="@(groups.Count > 0 ? string.Join(' ', groups) : null)" data-prefilled="@(prefilled ? "true" : "false")" hidden="@prefilled">
                <input type="checkbox" name="personIds" value="@p.Id" id="add-@p.Id" checked="@Model.Ticked.Contains(p.Id)" disabled="@prefilled">
                <partial name="_Avatar" model="p" />
                <label class="person-body person-name" for="add-@p.Id">@p.Name</label>
            </li>
        }
        <li class="person" data-add-people-address hidden>
            <input type="checkbox" name="email" id="add-people-address" checked disabled>
            <label class="person-body" for="add-people-address">
                <span class="person-name break">Add or invite <span data-add-people-typed></span></span>
                <span class="small">If someone already uses this address, they're added. If not, it's invited.</span>
            </label>
        </li>
    </ul>
</fieldset>
<div class="field" data-add-people-email>
    <label for="add-people-email">Or add or invite by email</label>
    <input id="add-people-email" name="email" type="email" value="@Model.Email" maxlength="@EventManager.EmailMax" autocomplete="off" placeholder="sue@example.com">
</div>

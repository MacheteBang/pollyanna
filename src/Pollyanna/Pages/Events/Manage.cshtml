@page "/events/{id:guid}/manage/{handler?}"
@model Pollyanna.Pages.Events.ManageModel
@using Pollyanna.Events
@using Pollyanna.Infrastructure
@{
    ViewData["Title"] = "Organizing " + Model.Event.Name;
    var m = Model.Membership;
    var editable = m.PeopleEditable;
    var drawn = m.IsLive;
    string Household(Guid? id) => Model.Households.FirstOrDefault(h => h.Id == id)?.Name ?? "no household";
    var lateJoiner = new Pollyanna.Pages.Shared.PickOneView("late", Model.Known, "Who's joining", "they're added");
    // The row of steps (spec §12 Statuses): the current one in ink; an archived event has passed them all.
    string[] Steps = ["Draft", "Open", "Names drawn", "Revealed"];
    var step = Model.Event.Status switch
    {
        EventStatus.Draft => 0,
        EventStatus.Open => 1,
        EventStatus.Drawn => 2,
        EventStatus.Revealed => 3,
        _ => Steps.Length,
    };
    var newOrganizer = new Pollyanna.Pages.Shared.PickOneView("organizer", Model.KnownNotOrganizing, "Add an organizer", "they're made an organizer");
}

<div class="column page-head">
    @* The event's name first; the switch right under it, or a "Home" back link above it for an
       organizer who doesn't take part (spec §7 Page head). *@
    @if (!m.IsParticipant)
    {
        <a class="page-head-back" href="/">Home</a>
    }
    <h1 class="page-title">@Model.Event.Name</h1>
    @if (m.IsParticipant)
    {
        <partial name="_EventSwitch" model="new Pollyanna.Pages.Shared.EventSwitchView(Model.Event.Id, Organizing: true)" />
    }
    <p class="page-head-line"><partial name="_When" model="Model.Event.ExchangeDate" />@(string.IsNullOrWhiteSpace(Model.Event.BudgetText) ? "" : " · " + Model.Event.BudgetText)</p>
    <ol class="steps" aria-label="Where this event stands">
        @for (var i = 0; i < Steps.Length; i++)
        {
            <li class="@(i < step ? "step-done" : i == step ? "step-now" : null)" aria-current="@(i == step ? "step" : null)">@Steps[i]</li>
        }
    </ol>
</div>

@if (Model.Event.Status != EventStatus.Archived)
{
    @* The next step (spec §7): one sentence and one filled button on the cloth, or what blocks it. *@
    <div class="cloth" id="next-step">
        <div class="panel">
            @switch (Model.Event.Status)
            {
                case EventStatus.Draft:
                    <p>Only organizers can see this event. Open it so the people you've added can write their notes.</p>
                    <form method="post" asp-page-handler="Open" class="actions">
                        <button type="submit" class="button button-fill">Open the event</button>
                    </form>
                    break;
                case EventStatus.Open when Model.Check is { CanDraw: true } check:
                    <p>@Model.ReadySentence</p>
                    if (check.Predictable)
                    {
                        <p id="draw-warning"><strong>Pairings may be easy to guess.</strong> With this few people, or rules this tight, there are only a few ways the names can fall. Participants, or an organizer who set the rules, may be able to work out who drew whom. Loosen a household or rule, or draw anyway.</p>
                    }
                    if (check.NoRepeatIncomplete)
                    {
                        <p class="small soft" id="no-repeat-warning">@EventManager.NoRepeatIncompleteWarning</p>
                    }
                    <form method="post" asp-page-handler="Draw" class="actions">
                        <button type="submit" class="button button-fill">@(check.Predictable ? "Draw anyway" : "Draw names")</button>
                    </form>
                    break;
                case EventStatus.Open when Model.Check is { } blocked:
                    <p id="draw-blocked">@(blocked.Blocker ?? blocked.Problem)</p>
                    if (blocked.NoRepeatIncomplete)
                    {
                        <p class="small soft" id="no-repeat-warning">@EventManager.NoRepeatIncompleteWarning</p>
                    }
                    @* The way to fix it, where it is on this page (spec §7): a link to the fold that
                       holds it, which the page renders open while the blocker stands; the script
                       opens it again if it was closed. *@
                    if (Model.TooFewPeople && editable)
                    {
                        <div class="actions"><a class="button button-fill" href="#add-people" data-opens>Add people</a></div>
                    }
                    else if (Model.RulesBlockTheDraw && editable)
                    {
                        <div class="actions"><a class="button button-fill" href="#rules" data-opens>Change who can't draw whom</a></div>
                    }
                    break;
                case EventStatus.Drawn when Model.Leaving.Count > 0:
                    <p id="leave-blocker">@Model.LeavingSentence</p>
                    <form method="post" asp-page-handler="Redraw" class="actions">
                        <button type="submit" class="button button-fill">Draw names again</button>
                    </form>
                    @foreach (var p in Model.Leaving)
                    {
                        <form method="post" asp-page-handler="KeepIn">
                            <input type="hidden" name="personId" value="@p.Id">
                            <button type="submit" class="link-button small">Keep @p.Name in instead</button>
                        </form>
                    }
                    break;
                case EventStatus.Drawn:
                    <p>@Model.DrawnSentence</p>
                    <form method="post" asp-page-handler="Reveal" class="actions">
                        @if (Model.RevealNeedsConfirmation)
                        {
                            <label class="check">
                                <input type="checkbox" name="confirmed" value="true" required>
                                <span>The exchange isn't until @Format.Date(Model.Event.ExchangeDate). Reveal anyway.</span>
                            </label>
                        }
                        <button type="submit" class="button button-fill">Reveal who drew whom</button>
                    </form>
                    break;
                case EventStatus.Revealed:
                    <p>Everyone can see who drew whom. Archive the event when you're done with it, and it moves to past events.</p>
                    <form method="post" asp-page-handler="Archive" class="actions">
                        <label class="check">
                            <input type="checkbox" name="keepMessages" value="true">
                            <span>Keep the question threads. Each stays readable by its own two people only. Otherwise they're deleted.</span>
                        </label>
                        <button type="submit" class="button button-fill">Archive this event</button>
                    </form>
                    break;
            }
        </div>
    </div>
}

<div class="column below">
    @if (Model.Event.Status == EventStatus.Archived)
    {
        <p id="archived" class="soft">This event is archived. Nothing about it can change any more.</p>
    }

    @if (Model.Pairings is { } pairings)
    {
        @* Once revealed, the full list takes the place of the people (spec §7): it names everyone. *@
        <section id="pairings" aria-labelledby="pairings-heading">
            <h2 id="pairings-heading" class="group-title">Who drew whom</h2>
            <partial name="_WhoDrewWhom" model="pairings" />
        </section>
    }
    else
    {
        @* The people (spec §7): a row says in small words what is missing, or "done shopping"; a row
           with nothing to say stays quiet. What organizers may see is §5.5: never who drew whom. *@
        <section id="people" aria-labelledby="people-heading">
            <h2 id="people-heading" class="group-title">Taking part (@Model.Participants.Count)</h2>
            @if (Model.Participants.Count == 0)
            {
                <p class="soft">Nobody's taking part yet.</p>
            }
            else
            {
                <ul class="rows" role="list">
                    @foreach (var p in Model.Participants)
                    {
                        var words = Model.WordsFor(p);
                        <li class="row">
                            <partial name="_Avatar" model="p" />
                            <span class="row-name">@p.Name@(p.Id == Model.MeId ? " (you)" : "")</span>
                            @if (words is not null)
                            {
                                <span class="row-words small soft">@words</span>
                            }
                            @if (editable)
                            {
                                <form method="post" asp-page-handler="RemovePerson" class="row-end">
                                    <input type="hidden" name="personId" value="@p.Id">
                                    <button type="submit" class="link-button small" aria-label="Remove @p.Name">Remove</button>
                                </form>
                            }
                        </li>
                    }
                </ul>
            }
        </section>
    }

    @if (Model.Invitations.Count > 0)
    {
        <section id="invited" aria-labelledby="invited-heading">
            <h2 id="invited-heading" class="group-title">Invited, not signed in yet (@Model.Invitations.Count)</h2>
            <ul class="rows" role="list">
                @foreach (var i in Model.Invitations)
                {
                    <li class="row">
                        <span class="row-name row-plain break">@i.Email</span>
                        @if (editable)
                        {
                            <form method="post" asp-page-handler="CancelInvite" class="row-end">
                                <input type="hidden" name="invitationId" value="@i.Id">
                                <button type="submit" class="link-button small" aria-label="Take back the invitation to @i.Email">Take back</button>
                            </form>
                        }
                    </li>
                }
            </ul>
        </section>
    }

    @if (editable)
    {
        @* One control for adding people (spec §7): the people the organizer has shared an event
           with, names and pictures only, and an address that adds or invites (_AddPeople). Behind
           the "Add people" fold row (§12 Controls), open when adding people is the next step. *@
        <details class="fold" id="add-people" open="@Model.TooFewPeople">
            <summary><span>Add people</span></summary>
            <form method="post" asp-page-handler="AddPeople" class="fold-body add-people" data-add-people>
                <partial name="_AddPeople" model="new AddPeopleControl(Model.Known, [], null)" />
                <button type="submit" class="button button-start">Add ticked</button>
                <p class="hint">Only people you've shared an event with are listed. For anyone else, type their email: if they already use Pollyanna they're added, and if not, the address is invited and they join when they first sign in with it.</p>
            </form>
        </details>
    }
    else if (drawn)
    {
        <p class="small soft">Invitations by email wait until names are drawn again.</p>
    }

    @* "Who can't draw whom" and "Details and organizers" (spec §7): closed rows with a summary on
       the right that open in place. A redirect back here names a spot inside one, which opens it. *@
    <div class="folds">
        <details class="fold" id="rules" open="@Model.RulesBlockTheDraw">
            <summary><span id="rules-heading">Who can't draw whom</span><span class="fold-hint">@Model.RulesSummary</span></summary>
            <div class="fold-body">
                <p class="small soft">People in the same household never draw each other.</p>
                @if (Model.Households.Count > 0 || Model.Exclusions.Count > 0)
                {
                    <ul class="rows" role="list">
                        @foreach (var h in Model.Households)
                        {
                            <li class="row household">
                                <span class="row-stack">
                                    <span class="household-name">@h.Name</span>
                                    <span class="small soft">@(h.Members.Count == 0 ? "Nobody yet" : string.Join(", ", h.Members.Select(x => x.Name)))</span>
                                </span>
                            </li>
                            @if (editable)
                            {
                                <li class="row-more">
                                    <details class="editor">
                                        <summary>Edit <span class="visually-hidden">@h.Name</span></summary>
                                        <form method="post" asp-page-handler="SaveHousehold" class="stack">
                                            <input type="hidden" name="householdId" value="@h.Id">
                                            <div class="field">
                                                <label for="hh-name-@h.Id">Name</label>
                                                <input id="hh-name-@h.Id" name="householdName" value="@h.Name" required maxlength="@EventManager.HouseholdNameMax" autocomplete="off">
                                            </div>
                                            <fieldset class="choices">
                                                <legend>Who's in it</legend>
                                                @foreach (var p in Model.Participants)
                                                {
                                                    <label class="check">
                                                        <input type="checkbox" name="members" value="@p.Id" checked="@(p.HouseholdId == h.Id)">
                                                        <span>@p.Name@(p.HouseholdId is { } other && other != h.Id ? $" (now in {Household(other)})" : "")</span>
                                                    </label>
                                                }
                                            </fieldset>
                                            <button type="submit" class="button button-start">Save household</button>
                                        </form>
                                        <form method="post" asp-page-handler="DeleteHousehold">
                                            <input type="hidden" name="householdId" value="@h.Id">
                                            <button type="submit" class="link-button small">Remove this household</button>
                                        </form>
                                    </details>
                                </li>
                            }
                        }
                        @foreach (var x in Model.Exclusions)
                        {
                            <li class="row">
                                <span class="row-stack">
                                    <strong>@x.A can't draw @x.B</strong>
                                    <span class="small soft">extra rule (both ways)</span>
                                </span>
                                @if (editable)
                                {
                                    <form method="post" asp-page-handler="RemoveRule" class="row-end">
                                        <input type="hidden" name="exclusionId" value="@x.Id">
                                        <button type="submit" class="link-button small" aria-label="Remove the rule for @x.A and @x.B">Remove</button>
                                    </form>
                                }
                            </li>
                        }
                    </ul>
                }
                @if (drawn || Model.Event.Status == EventStatus.Revealed)
                {
                    <p class="small soft">Names are drawn, so these can't change unless you draw names again.</p>
                }
                @if (editable)
                {
                    <details class="fold">
                        <summary><span>Add a household</span></summary>
                        <form method="post" asp-page-handler="SaveHousehold" class="fold-body">
                            <div class="field">
                                <label for="hh-name-new">Name</label>
                                <input id="hh-name-new" name="householdName" required maxlength="@EventManager.HouseholdNameMax" autocomplete="off" placeholder="e.g. Mom &amp; Dad">
                            </div>
                            @if (Model.Participants.Count > 0)
                            {
                                <fieldset class="choices">
                                    <legend>Who's in it</legend>
                                    @foreach (var p in Model.Participants)
                                    {
                                        <label class="check">
                                            <input type="checkbox" name="members" value="@p.Id">
                                            <span>@p.Name@(p.HouseholdId is { } other ? $" (now in {Household(other)})" : "")</span>
                                        </label>
                                    }
                                </fieldset>
                            }
                            <button type="submit" class="button button-start">Add household</button>
                        </form>
                    </details>
                    @if (Model.Participants.Count >= 2)
                    {
                        <details class="fold">
                            <summary><span>Add a rule</span></summary>
                            <form method="post" asp-page-handler="AddRule" class="fold-body">
                                <div class="field">
                                    <label for="rule-a">This person</label>
                                    <select id="rule-a" name="personA" required>
                                        <option value="">Pick a person…</option>
                                        @foreach (var p in Model.Participants)
                                        {
                                            <option value="@p.Id">@p.Name</option>
                                        }
                                    </select>
                                </div>
                                <div class="field">
                                    <label for="rule-b">never draws, and is never drawn by</label>
                                    <select id="rule-b" name="personB" required>
                                        <option value="">Pick a person…</option>
                                        @foreach (var p in Model.Participants)
                                        {
                                            <option value="@p.Id">@p.Name</option>
                                        }
                                    </select>
                                </div>
                                <button type="submit" class="button button-start">Add rule</button>
                            </form>
                        </details>
                    }
                }
            </div>
        </details>

        <details class="fold" id="settings" open="@(Model.DetailsError is not null)">
            <summary><span id="settings-heading">Details and organizers</span><span class="fold-hint">@Model.OrganizersSummary</span></summary>
            <div class="fold-body">
                <div id="details">
                    <ul class="rows" role="list">
                        <li class="row"><span>Name</span><strong class="row-value">@Model.Event.Name</strong></li>
                        <li class="row"><span>Exchange date</span><strong class="row-value">@Format.Date(Model.Event.ExchangeDate)</strong></li>
                        <li class="row"><span>Budget</span><strong class="row-value">@(string.IsNullOrWhiteSpace(Model.Event.BudgetText) ? "None" : Model.Event.BudgetText)</strong></li>
                    </ul>
                    @if (Model.DetailsError is not null)
                    {
                        <p class="error" role="alert">@Model.DetailsError</p>
                    }
                    @if (m.Editable)
                    {
                        <details class="fold" open="@(Model.DetailsError is not null)">
                            <summary><span>Edit details</span></summary>
                            <form method="post" asp-page-handler="Details" class="fold-body">
                                <div class="field">
                                    <label for="name">Name</label>
                                    <input id="name" name="Name" value="@Model.Name" required maxlength="@EventManager.NameMax" autocomplete="off">
                                </div>
                                <div class="field-row">
                                    <div class="field">
                                        <label for="budget">Budget</label>
                                        <input id="budget" name="BudgetText" value="@Model.BudgetText" maxlength="@EventManager.BudgetMax" autocomplete="off">
                                    </div>
                                    <div class="field">
                                        <label for="date">Exchange date</label>
                                        <input id="date" name="ExchangeDate" type="date" value="@(Model.ExchangeDate is { } d ? Format.IsoDate(d) : "")" required min="2000-01-01" max="2100-12-31">
                                    </div>
                                </div>
                                @if (editable)
                                {
                                    <div class="field">
                                        <label for="previous">Last year's event</label>
                                        <select id="previous" name="PreviousEventId">
                                            <option value="" selected="@(Model.PreviousEventId is null)">None</option>
                                            @foreach (var c in Model.PreviousCandidates)
                                            {
                                                <option value="@c.Id" selected="@(c.Id == Model.PreviousEventId)">@(c.Status == EventStatus.Canceled ? "a canceled event" : c.Name)</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="field">
                                        <label for="depth">Don't repeat a pairing from the last…</label>
                                        <select id="depth" name="NoRepeatDepth">
                                            @for (var n = 1; n <= EventManager.MaxNoRepeatDepth; n++)
                                            {
                                                <option value="@n" selected="@(n == Model.NoRepeatDepth)">@(n == 1 ? "1 year" : $"{n} years")</option>
                                            }
                                        </select>
                                        <p class="hint">Only applies when the event is linked to last year's.</p>
                                    </div>
                                }
                                else
                                {
                                    <input type="hidden" name="PreviousEventId" value="@Model.PreviousEventId">
                                    <input type="hidden" name="NoRepeatDepth" value="@Model.NoRepeatDepth">
                                }
                                <button type="submit" class="button button-start">Save details</button>
                            </form>
                        </details>
                    }
                </div>

                <div id="organizers">
                    <h3 class="group-subtitle">Organizers</h3>
                    <ul class="rows" role="list">
                        @foreach (var o in Model.Organizers)
                        {
                            <li class="row">
                                <partial name="_Avatar" model="o" />
                                <span class="row-name">@o.Name@(o.Id == Model.MeId ? " (you)" : "")</span>
                                @if (Model.Organizers.Count > 1 && m.Editable)
                                {
                                    <form method="post" asp-page-handler="RemoveOrganizer" class="row-end">
                                        <input type="hidden" name="personId" value="@o.Id">
                                        <button type="submit" class="link-button small" aria-label="@(o.Id == Model.MeId ? "Stop organizing" : $"Remove {o.Name} as organizer")">@(o.Id == Model.MeId ? "Step down" : "Remove")</button>
                                    </form>
                                }
                            </li>
                        }
                    </ul>
                    <p class="small soft">Organizers manage the event but don't see who drew whom. Being one doesn't make them a participant.</p>
                    @if (Model.Organizers.Count == 1)
                    {
                        <p class="small soft">You're the only organizer. Add a second one so the event isn't stuck if you're away.</p>
                    }
                    @if (m.Editable)
                    {
                        <details class="fold">
                            <summary><span>Add an organizer</span></summary>
                            <form method="post" asp-page-handler="AddOrganizer" class="fold-body add-people" data-add-people>
                                <partial name="_PickOne" model="newOrganizer" />
                                <p class="hint">They need to have signed in.</p>
                                <button type="submit" class="button button-start">Make organizer</button>
                            </form>
                        </details>
                    }
                </div>
            </div>
        </details>
    </div>

    @* "Bigger changes" (spec §7): always open, at the very bottom. Each change is an outlined
       button that opens its confirmation in place, with one small line on what it does. Before the
       draw the group holds cancel alone; once revealed, cancel and a line saying nothing else can
       change. Only cancel is red. *@
    @if (m.Allows(EventLifecycle.Cancel))
    {
        <section id="changes" aria-labelledby="changes-heading">
            <h2 id="changes-heading" class="group-title">Bigger changes</h2>
            <div class="changes">
                @if (drawn)
                {
                    <div class="change" id="dropout">
                        <details>
                            <summary class="button">Someone is dropping out</summary>
                            <form method="post" asp-page-handler="RemovePerson" class="change-confirm">
                                <div class="field">
                                    <label for="dropout-person">Who's dropping out</label>
                                    <select id="dropout-person" name="personId" required>
                                        <option value="">Pick a person…</option>
                                        @foreach (var p in Model.Participants)
                                        {
                                            <option value="@p.Id">@p.Name</option>
                                        }
                                    </select>
                                </div>
                                <p class="small">Patch: whoever gives to them takes over who they were giving to, if the draw rules allow it. Only that one person's recipient changes, and nobody, you included, is told whose.</p>
                                <button type="submit" name="change" value="Patch" class="button button-start">Take them out and patch</button>
                                <button type="submit" name="change" value="Redraw" class="button button-start">Take them out and draw names again</button>
                            </form>
                        </details>
                        <p class="change-line small soft">Only that one person's recipient changes, and nobody, you included, is told whose.</p>
                    </div>
                    <div class="change" id="late">
                        <details>
                            <summary class="button">Someone is joining late</summary>
                            <form method="post" asp-page-handler="AddPerson" class="change-confirm add-people" data-add-people>
                                <partial name="_PickOne" model="lateJoiner" />
                                <p class="small">They need to have signed in. Invitations by email wait until names are drawn again.</p>
                                @if (Model.Households.Count > 0)
                                {
                                    <div class="field">
                                        <label for="late-household">Household</label>
                                        <select id="late-household" name="householdId">
                                            <option value="">None</option>
                                            @foreach (var h in Model.Households)
                                            {
                                                <option value="@h.Id">@h.Name</option>
                                            }
                                        </select>
                                    </div>
                                }
                                <p class="small">Patch: one person who may give to them gives to them instead, and they take over who that person was giving to. Only that one person's recipient changes.</p>
                                <button type="submit" name="change" value="Patch" class="button button-start">Add them and patch</button>
                                <button type="submit" name="change" value="Redraw" class="button button-start">Add them and draw names again</button>
                            </form>
                        </details>
                        <p class="change-line small soft">One person gives to someone new to make room. Nobody else changes.</p>
                    </div>
                    @* While someone waits to leave, drawing again is the next step itself. *@
                    @if (Model.Leaving.Count == 0)
                    {
                        <div class="change" id="redraw">
                            <details>
                                <summary class="button">Draw names again</summary>
                                <form method="post" asp-page-handler="Redraw" class="change-confirm">
                                    <p>Every assignment is deleted and the event goes back to open, so people and rules can change before you draw again. Everyone is told names were drawn again.</p>
                                    <button type="submit" class="button button-start">Draw names again</button>
                                </form>
                            </details>
                            <p class="change-line small soft">Every assignment is deleted and the event goes back to open. Everyone is told names were drawn again.</p>
                        </div>
                    }
                    <partial name="_Archive" model="Model.Participants" />
                }
                <partial name="_Cancel" model="Model" />
                @if (Model.Event.Status == EventStatus.Revealed)
                {
                    <p class="small soft">Nothing to change now that everyone's been revealed.</p>
                }
            </div>
        </section>
    }
</div>

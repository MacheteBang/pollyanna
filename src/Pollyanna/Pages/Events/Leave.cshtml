@page "/events/{id:guid}/leave"
@model Pollyanna.Pages.Events.LeaveModel
@* The leave confirmation (spec §7 Confirmations, §4 Leaving): the question is the page title, what
   it costs follows as plain text, then the filled button repeating the action and "Stay in". No
   cloth. Once names are drawn there is a second step, saying someone else's assignment changes. *@
@{
    ViewData["Title"] = "Leave " + Model.Event.Name;
    var head = new Pollyanna.Pages.Shared.PageHeadView("Leave this event?", Back: new(Model.Event.Name, $"/events/{Model.Event.Id}"));
}
<partial name="_PageHead" model="head" />
<div class="column below confirm">
    @if (Model.SecondStep)
    {
        <p>Names are drawn, so one other person will be giving to someone new.</p>
        <p class="small soft">If the draw rules don't allow that, or too few people would be left, you stay in until the organizers draw names again.</p>
    }
    else
    {
        <p>Your notes for this event are deleted.</p>
        @if (!Model.Membership.IsLive)
        {
            <p>An organizer can add you back before names are drawn.</p>
        }
        @if (Model.Membership.IsOrganizer)
        {
            <p>You'll still organize the event.</p>
        }
    }
    <form method="post" action="/events/@Model.Event.Id/leave" asp-antiforgery="true" class="actions">
        @if (Model.SecondStep)
        {
            <input type="hidden" name="confirmed" value="true">
        }
        <button type="submit" class="button button-fill">Leave this event</button>
        <a class="way-out" href="/events/@Model.Event.Id">Stay in</a>
    </form>
</div>

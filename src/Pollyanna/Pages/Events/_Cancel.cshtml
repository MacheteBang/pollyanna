@* "Cancel this event" under "Bigger changes" on the organizing page, for every status but archived
   (spec §4, §7). The one red button on the page. *@
@model Pollyanna.Pages.Events.ManageModel
@using Pollyanna.Infrastructure
@{
    var people = Model.Participants.Count;
    var invitations = Model.Invitations.Count;
}
<div class="change" id="cancel">
    <details>
        <summary class="button button-red">Cancel this event</summary>
        <form method="post" asp-page-handler="Cancel" class="change-confirm">
            <p><strong>Cancel @Model.Event.Name?</strong> This can't be undone. The event disappears for everyone, organizers included.</p>
            <ul class="change-costs">
                <li>@Format.People(people) in it@(invitations > 0 ? (invitations == 1 ? ", and 1 invitation still waiting" : $", and {invitations} invitations still waiting") : "").</li>
                @if (Model.Membership.NamesDrawn)
                {
                    <li>Everyone's assignments go, and any question-box messages are deleted.</li>
                }
                <li>Nobody is emailed.</li>
            </ul>
            <button type="submit" class="button button-red button-start">Cancel this event</button>
            <a class="way-out" href="/events/@Model.Event.Id/manage">Keep it</a>
        </form>
    </details>
    <p class="change-line small soft">Everyone's assignments go, and any question-box messages are deleted. This can't be undone.</p>
</div>

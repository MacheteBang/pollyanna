# Pollyanna settings for compose.yaml. Copy to .env and fill in; keep .env private
# (it holds the client secret): chmod 600 .env
# Every setting is described in DEPLOYMENT.md.

# The image to run, pinned to a release.
POLLYANNA_IMAGE=ghcr.io/machetebang/pollyanna:0.0.3

# The address people open in their browser: a bare origin, no path.
POLLYANNA_PUBLIC_URL=https://pollyanna.example

# The OpenID Connect provider and Pollyanna's client registration there.
POLLYANNA_OIDC_ISSUER=https://id.example
POLLYANNA_OIDC_CLIENT_ID=pollyanna
POLLYANNA_OIDC_CLIENT_SECRET=change-me

# Or keep the secret in its own file instead: remove POLLYANNA_OIDC_CLIENT_SECRET above,
# mount the file into the container (read-only) and name its container path here.
# POLLYANNA_OIDC_CLIENT_SECRET_FILE=/run/secrets/pollyanna-client-secret

# Optional: email notifications through your mail relay (DEPLOYMENT.md, "Email
# notifications"). Leave POLLYANNA_SMTP_HOST unset, and the rest with it, for no email.
# POLLYANNA_SMTP_HOST=smtp.example
# POLLYANNA_SMTP_PORT=587
# POLLYANNA_SMTP_TLS=starttls
# POLLYANNA_SMTP_USERNAME=pollyanna
# POLLYANNA_SMTP_PASSWORD=change-me
# POLLYANNA_MAIL_FROM=Pollyanna <pollyanna@home.example>
